            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "",
                  "const j = pm.response.json();",
                  "pm.test(\"Devuelve id, estado ACTIVO y cabecera Location\", () => {",
                  "  pm.expect(j.id).to.be.a(\"number\"); pm.expect(j.estado).to.eql(\"ACTIVO\");",
                  "  pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/api/productos/\" + j.id); });",
                  "pm.collectionVariables.set(\"productoId\", j.id);",
                  "pm.collectionVariables.set(\"productoPrecio\", j.precio);"
                ]
              }
            }
          ],
