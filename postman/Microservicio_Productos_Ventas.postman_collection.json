                  "pm.test(\"Código HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "",
                  "const j = pm.response.json();",
                  "const pT = Number(pm.collectionVariables.get(\"productoPrecio\"));",
                  "const pM = Number(pm.collectionVariables.get(\"mousePrecio\"));",
                  "pm.test(\"Subtotales = cantidad × precio unitario\", () => {",
                  "  pm.expect(j.detalles[0].subtotal).to.be.closeTo(3 * pT, 0.001);",
                  "  pm.expect(j.detalles[1].subtotal).to.be.closeTo(2 * pM, 0.001); });",
                  "pm.test(\"Total = suma de subtotales\", () => pm.expect(j.total).to.be.closeTo(3 * pT + 2 * pM, 0.001));",
                  "pm.test(\"Estado REGISTRADA y Location\", () => { pm.expect(j.estado).to.eql(\"REGISTRADA\");",
                  "  pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/api/ventas/\" + j.id); });",
                  "pm.collectionVariables.set(\"ventaId\", j.id);"
                ]
              }
            }
